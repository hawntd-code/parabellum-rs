          "from": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "image": {
            ".validate": "newData.val() === true"
          },
          "w": {
            ".validate": "newData.isNumber()"
          },
          "h": {
            ".validate": "newData.isNumber()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "edited": {
            ".validate": "newData.isNumber()"
          },
          "reply": {
            ".validate": "newData.hasChildren(['id', 'name', 'text'])",
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "reactions": {
      "$chat": {
        ".read": "auth != null && root.child('chats').child($chat).child('members').child(auth.uid).val() === true",
        "$msg": {
          ".write": "auth != null && !newData.exists() && root.child('messages').child($chat).child($msg).child('from').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chat).child('members').child(auth.uid).val() === true",
            ".validate": "newData.isString() && newData.val().length <= 16 && root.child('messages').child($chat).child($msg).exists()"
          }
        }
      }
    },
    "images": {
      "$chat": {
        ".read": "auth != null && root.child('chats').child($chat).child('members').child(auth.uid).val() === true",
        "$msg": {
          ".write": "auth != null && root.child('chats').child($chat).child('members').child(auth.uid).val() === true && (!data.exists() || (!newData.exists() && root.child('messages').child($chat).child($msg).child('from').val() === auth.uid))",
          ".validate": "newData.isString() && newData.val().length <= 450000 && newData.val().beginsWith('data:image/')"
        }
