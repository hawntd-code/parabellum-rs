{
  "rules": {
    "names": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.isString() && newData.val() === auth.uid && $name.matches(/^[a-z0-9_]{1,16}$/)"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('name').isString() && newData.parent().parent().child('names').child(newData.child('name').val().toLowerCase()).val() === auth.uid",
        "name": {
          ".validate": "newData.val().matches(/^[A-Za-z0-9_]{1,16}$/)"
        },
        "uuid": {
          ".validate": "newData.isString() && newData.val().length <= 36"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "requests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)",
          ".validate": "$from !== $to && newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('at').isNumber()"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && ((!newData.exists() && (auth.uid === $uid || auth.uid === $other)) || (auth.uid === $uid && root.child('requests').child($uid).child($other).exists()) || (auth.uid === $other && root.child('requests').child($other).child($uid).exists()))",
          ".validate": "newData.val() === true"
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('state').isString() && newData.child('updated').isNumber()",
        "$field": {
          ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 200)"
        }
      }
    },
    "servers": {
      "$uid": {
        "$server": {
          ".read": "auth != null && (auth.uid === $uid || data.child('guests').child(auth.uid).val() === true)",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "$server.matches(/^s[0-9a-f]{12}$/) && newData.child('name').isString() && newData.child('updated').isNumber()",
          "guests": {
            "$guest": {
              ".validate": "newData.val() === true"
            }
          },
          "$field": {
            ".validate": "newData.isNumber() || newData.isBoolean() || (newData.isString() && newData.val().length <= 200)"
          }
        }
      }
    },
    "invites": {
      "$guest": {
        ".read": "auth != null && auth.uid === $guest",
        "$host": {
          "$server": {
            ".write": "auth != null && (auth.uid === $host || (auth.uid === $guest && !newData.exists()))",
            ".validate": "newData.val() === true && root.child('friends').child($host).child($guest).val() === true"
          }
        }
      }
    },
    "chats": {
      "$chat": {
        ".read": "auth != null && data.child('members').child(auth.uid).val() === true",
        "members": {
          "$member": {
            ".write": "auth != null && ((!newData.exists() && $member === auth.uid) || (newData.val() === true && ($member === auth.uid || root.child('friends').child(auth.uid).child($member).val() === true) && (!data.parent().exists() || data.parent().child(auth.uid).val() === true)))",
            ".validate": "newData.val() === true"
          }
        },
        "meta": {
          ".write": "auth != null && newData.parent().child('members').child(auth.uid).val() === true",
          "kind": {
            ".validate": "newData.val() === 'directo' || newData.val() === 'grupo'"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "lastText": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "lastName": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "lastUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "lastAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "messages": {
      "$chat": {
        ".read": "auth != null && root.child('chats').child($chat).child('members').child(auth.uid).val() === true",
        "$msg": {
          ".write": "auth != null && root.child('chats').child($chat).child('members').child(auth.uid).val() === true && (!data.exists() || data.child('from').val() === auth.uid)",
          ".validate": "newData.child('from').val() === auth.uid && newData.child('at').isNumber() && (newData.child('text').isString() || newData.child('image').val() === true) && (!data.exists() || (data.child('text').isString() && newData.child('text').isString() && newData.child('at').val() === data.child('at').val() && newData.child('edited').isNumber()))",
          "from": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "image": {
            ".validate": "newData.val() === true"
          },
          "w": {
            ".validate": "newData.isNumber()"
          },
          "h": {
            ".validate": "newData.isNumber()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "edited": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "images": {
      "$chat": {
        ".read": "auth != null && root.child('chats').child($chat).child('members').child(auth.uid).val() === true",
        "$msg": {
          ".write": "auth != null && root.child('chats').child($chat).child('members').child(auth.uid).val() === true && (!data.exists() || (!newData.exists() && root.child('messages').child($chat).child($msg).child('from').val() === auth.uid))",
          ".validate": "newData.isString() && newData.val().length <= 450000 && newData.val().beginsWith('data:image/')"
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chat": {
          ".write": "auth != null && (auth.uid === $uid || (newData.parent().parent().parent().child('chats').child($chat).child('members').child(auth.uid).val() === true && newData.parent().parent().parent().child('chats').child($chat).child('members').child($uid).val() === true))",
          ".validate": "newData.val() === true"
        }
      }
    },
    "reads": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$chat": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "favorites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "since": {
          ".validate": "newData.isNumber()"
        },
        "chats": {
          "$chat": {
            ".validate": "newData.val() === true && $chat.length <= 200"
          }
        },
        "mods": {
          "$project": {
            ".validate": "$project.matches(/^[A-Za-z0-9_-]{1,64}$/) && newData.child('title').isString() && newData.child('title').val().length <= 100 && (newData.child('kind').val() === 'mod' || newData.child('kind').val() === 'resourcepack' || newData.child('kind').val() === 'shader') && newData.child('at').isNumber()",
            "title": {
              ".validate": "newData.isString()"
            },
            "kind": {
              ".validate": "newData.isString()"
            },
            "icon": {
              ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().beginsWith('https://')"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
