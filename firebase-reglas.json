{
  "rules": {
    "names": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.isString() && newData.val() === auth.uid && $name.matches(/^[a-z0-9_]{1,16}$/)"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('name').isString() && newData.parent().parent().child('names').child(newData.child('name').val().toLowerCase()).val() === auth.uid",
        "name": {
          ".validate": "newData.val().matches(/^[A-Za-z0-9_]{1,16}$/)"
        },
        "uuid": {
          ".validate": "newData.isString() && newData.val().length <= 36"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "requests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && (auth.uid === $from || (auth.uid === $to && !newData.exists()))",
          ".validate": "$from !== $to && newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('at').isNumber()"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && ((!newData.exists() && (auth.uid === $uid || auth.uid === $other)) || (auth.uid === $uid && root.child('requests').child($uid).child($other).exists()) || (auth.uid === $other && root.child('requests').child($other).child($uid).exists()))",
          ".validate": "newData.val() === true"
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('state').isString() && newData.child('updated').isNumber()",
        "$field": {
          ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 200)"
        }
      }
    },
    "servers": {
      "$uid": {
        "$server": {
          ".read": "auth != null && (auth.uid === $uid || data.child('guests').child(auth.uid).val() === true)",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "$server.matches(/^s[0-9a-f]{12}$/) && newData.child('name').isString() && newData.child('updated').isNumber()",
          "guests": {
            "$guest": {
              ".validate": "newData.val() === true"
            }
          },
          "$field": {
            ".validate": "newData.isNumber() || newData.isBoolean() || (newData.isString() && newData.val().length <= 200)"
          }
        }
      }
    },
    "invites": {
      "$guest": {
        ".read": "auth != null && auth.uid === $guest",
        "$host": {
          "$server": {
            ".write": "auth != null && (auth.uid === $host || (auth.uid === $guest && !newData.exists()))",
            ".validate": "newData.val() === true && root.child('friends').child($host).child($guest).val() === true"
          }
        }
      }
    },
    "chats": {
      "$chat": {
        ".read": "auth != null && data.child('members').child(auth.uid).val() === true",
        "members": {
          "$member": {
            ".write": "auth != null && ((!newData.exists() && ($member === auth.uid || root.child('chats').child($chat).child('meta').child('owner').val() === auth.uid)) || (newData.val() === true && ($member === auth.uid || root.child('friends').child(auth.uid).child($member).val() === true) && (!data.parent().exists() || data.parent().child(auth.uid).val() === true) && ($member === auth.uid || (!root.child('chats').child($chat).child('meta').child('owner').exists() || root.child('chats').child($chat).child('meta').child('owner').val() === auth.uid || root.child('chats').child($chat).child('members').child(root.child('chats').child($chat).child('meta').child('owner').val()).val() !== true))))",
            ".validate": "newData.val() === true"
          }
        },
        "meta": {
          ".write": "auth != null && !data.exists() && newData.parent().child('members').child(auth.uid).val() === true",
          "kind": {
            ".write": "auth != null && newData.parent().parent().child('members').child(auth.uid).val() === true",
            ".validate": "newData.val() === 'directo' || newData.val() === 'grupo'"
          },
          "name": {
            ".write": "auth != null && newData.parent().parent().child('members').child(auth.uid).val() === true && (!root.child('chats').child($chat).child('meta').child('owner').exists() || root.child('chats').child($chat).child('meta').child('owner').val() === auth.uid || root.child('chats').child($chat).child('members').child(root.child('chats').child($chat).child('meta').child('owner').val()).val() !== true)",
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "photo": {
            ".write": "auth != null && newData.parent().parent().child('members').child(auth.uid).val() === true && (!root.child('chats').child($chat).child('meta').child('owner').exists() || root.child('chats').child($chat).child('meta').child('owner').val() === auth.uid || root.child('chats').child($chat).child('members').child(root.child('chats').child($chat).child('meta').child('owner').val()).val() !== true)",
            ".validate": "newData.isString() && newData.val().length <= 40000 && newData.val().beginsWith('data:image/')"
          },
          "owner": {
            ".write": "auth != null && root.child('chats').child($chat).child('members').child(auth.uid).val() === true && (data.val() === auth.uid || (newData.val() === auth.uid && (!root.child('chats').child($chat).child('meta').child('owner').exists() || root.child('chats').child($chat).child('meta').child('owner').val() === auth.uid || root.child('chats').child($chat).child('members').child(root.child('chats').child($chat).child('meta').child('owner').val()).val() !== true)))",
            ".validate": "newData.isString() && newData.parent().parent().child('members').child(newData.val()).val() === true"
          },
          "created": {
            ".write": "auth != null && newData.parent().parent().child('members').child(auth.uid).val() === true",
            ".validate": "newData.isNumber()"
          },
          "lastText": {
            ".write": "auth != null && newData.parent().parent().child('members').child(auth.uid).val() === true",
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "lastName": {
            ".write": "auth != null && newData.parent().parent().child('members').child(auth.uid).val() === true",
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "lastUid": {
            ".write": "auth != null && newData.parent().parent().child('members').child(auth.uid).val() === true",
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "lastAt": {
            ".write": "auth != null && newData.parent().parent().child('members').child(auth.uid).val() === true",
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "messages": {
      "$chat": {
        ".read": "auth != null && root.child('chats').child($chat).child('members').child(auth.uid).val() === true",
        "$msg": {
          ".write": "auth != null && root.child('chats').child($chat).child('members').child(auth.uid).val() === true && (!data.exists() || data.child('from').val() === auth.uid)",
          ".validate": "newData.child('from').val() === auth.uid && newData.child('at').isNumber() && (newData.child('text').isString() || newData.child('image').val() === true) && (!data.exists() || (data.child('text').isString() && newData.child('text').isString() && newData.child('at').val() === data.child('at').val() && newData.child('edited').isNumber()))",
          "from": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "image": {
            ".validate": "newData.val() === true"
          },
          "w": {
            ".validate": "newData.isNumber()"
          },
          "h": {
            ".validate": "newData.isNumber()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "edited": {
            ".validate": "newData.isNumber()"
          },
          "reply": {
            ".validate": "newData.hasChildren(['id', 'name', 'text'])",
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "reactions": {
      "$chat": {
        ".read": "auth != null && root.child('chats').child($chat).child('members').child(auth.uid).val() === true",
        "$msg": {
          ".write": "auth != null && !newData.exists() && root.child('messages').child($chat).child($msg).child('from').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chat).child('members').child(auth.uid).val() === true",
            ".validate": "newData.isString() && newData.val().length <= 16 && root.child('messages').child($chat).child($msg).exists()"
          }
        }
      }
    },
    "images": {
      "$chat": {
        ".read": "auth != null && root.child('chats').child($chat).child('members').child(auth.uid).val() === true",
        "$msg": {
          ".write": "auth != null && root.child('chats').child($chat).child('members').child(auth.uid).val() === true && (!data.exists() || (!newData.exists() && root.child('messages').child($chat).child($msg).child('from').val() === auth.uid))",
          ".validate": "newData.isString() && newData.val().length <= 450000 && newData.val().beginsWith('data:image/')"
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chat": {
          ".write": "auth != null && (auth.uid === $uid || (newData.val() === true && newData.parent().parent().parent().child('chats').child($chat).child('members').child(auth.uid).val() === true && newData.parent().parent().parent().child('chats').child($chat).child('members').child($uid).val() === true) || (!newData.exists() && root.child('chats').child($chat).child('meta').child('owner').val() === auth.uid && newData.parent().parent().parent().child('chats').child($chat).child('members').child($uid).val() !== true))",
          ".validate": "newData.val() === true"
        }
      }
    },
    "reads": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$chat": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "favorites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "since": {
          ".validate": "newData.isNumber()"
        },
        "chats": {
          "$chat": {
            ".validate": "newData.val() === true && $chat.length <= 200"
          }
        },
        "mods": {
          "$project": {
            ".validate": "$project.matches(/^[A-Za-z0-9_-]{1,64}$/) && newData.child('title').isString() && newData.child('title').val().length <= 100 && (newData.child('kind').val() === 'mod' || newData.child('kind').val() === 'resourcepack' || newData.child('kind').val() === 'shader') && newData.child('at').isNumber()",
            "title": {
              ".validate": "newData.isString()"
            },
            "kind": {
              ".validate": "newData.isString()"
            },
            "icon": {
              ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().beginsWith('https://')"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "communities": {
      "$cid": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid) || (data.exists() && newData.exists() && newData.child('owner').val() === data.child('owner').val() && (root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'owner' || root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'admin')) || (data.exists() && !newData.exists() && data.child('owner').val() === auth.uid))",
        ".validate": "$cid.matches(/^c[0-9a-z]{12}$/) && newData.hasChildren(['name', 'owner', 'createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "image": {
          ".validate": "newData.isString() && newData.val().length <= 120000 && newData.val().beginsWith('data:image/')"
        },
        "owner": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "communityMembers": {
      "$cid": {
        ".read": "auth != null && data.child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && (($uid === auth.uid && !data.exists() && newData.child('role').val() === 'owner' && !newData.child('caps').exists() && newData.parent().parent().parent().child('communities').child($cid).child('owner').val() === auth.uid) || ($uid === auth.uid && !data.exists() && newData.child('role').val() === 'member' && !newData.child('caps').exists() && root.child('inviteCodes').child(newData.child('invite').val()).child('cid').val() === $cid && root.child('inviteCodes').child(newData.child('invite').val()).child('expiresAt').val() > now) || ($uid === auth.uid && !newData.exists() && data.child('role').val() !== 'owner') || ($uid !== auth.uid && root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'owner' && data.exists() && data.child('role').val() !== 'owner' && (!newData.exists() || newData.child('role').val() === 'member' || newData.child('role').val() === 'admin')) || ($uid !== auth.uid && root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'admin' && data.child('role').val() === 'member' && (!newData.exists() || newData.child('role').val() === 'member')))",
          ".validate": "newData.hasChildren(['role', 'name', 'joinedAt'])",
          "role": {
            ".validate": "newData.val() === 'owner' || newData.val() === 'admin' || newData.val() === 'member'"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "joinedAt": {
            ".validate": "newData.isNumber()"
          },
          "invite": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "caps": {
            "support": {
              ".validate": "newData.isBoolean()"
            },
            "publish": {
              ".validate": "newData.isBoolean()"
            },
            "servers": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "userCommunities": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$cid": {
          ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && (root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'owner' || root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'admin')))",
          ".validate": "newData.val() === true && newData.parent().parent().parent().child('communityMembers').child($cid).child($uid).exists()"
        }
      }
    },
    "inviteCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.exists() && (root.child('communityMembers').child(newData.child('cid').val()).child(auth.uid).child('role').val() === 'owner' || root.child('communityMembers').child(newData.child('cid').val()).child(auth.uid).child('role').val() === 'admin')) || (data.exists() && !newData.exists() && (root.child('communityMembers').child(data.child('cid').val()).child(auth.uid).child('role').val() === 'owner' || root.child('communityMembers').child(data.child('cid').val()).child(auth.uid).child('role').val() === 'admin')))",
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{8}$/) && newData.hasChildren(['cid', 'createdBy', 'expiresAt'])",
        "cid": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "createdBy": {
          ".validate": "newData.val() === auth.uid"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 2678400000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "communityInvites": {
      "$cid": {
        ".read": "auth != null && (root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'owner' || root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'admin')",
        "$code": {
          ".write": "auth != null && (root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'owner' || root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "communityServers": {
      "$cid": {
        ".read": "auth != null && root.child('communityMembers').child($cid).child(auth.uid).exists()",
        "$sid": {
          ".write": "auth != null && ((root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'owner' || root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'admin') || root.child('communityMembers').child($cid).child(auth.uid).child('caps').child('servers').val() === true)",
          ".validate": "$sid.matches(/^v[0-9a-z]{8}$/) && newData.hasChildren(['name', 'address'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "address": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "bedrock": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "package": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "order": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "communityPosts": {
      "$cid": {
        ".read": "auth != null && root.child('communityMembers').child($cid).child(auth.uid).exists()",
        "$pid": {
          ".write": "auth != null && (root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'owner' || root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.hasChildren(['title', 'text', 'author', 'at'])",
          "title": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "author": {
            ".validate": "newData.val() === auth.uid"
          },
          "authorName": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "communityRules": {
      "$cid": {
        ".read": "auth != null && root.child('communityMembers').child($cid).child(auth.uid).exists()",
        ".write": "auth != null && (root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'owner' || root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['text', 'at'])",
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 4000"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "by": {
          ".validate": "newData.val() === auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "communityPackages": {
      "$cid": {
        ".read": "auth != null && root.child('communityMembers').child($cid).child(auth.uid).exists()",
        "$pk": {
          ".write": "auth != null && ((root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'owner' || root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'admin') || root.child('communityMembers').child($cid).child(auth.uid).child('caps').child('publish').val() === true)",
          ".validate": "$pk.matches(/^p[0-9a-z]{8}$/) && newData.hasChildren(['name', 'catalogId', 'minecraft', 'at'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
          },
          "catalogId": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
          },
          "version": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "minecraft": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "loader": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "loaderVersion": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "contentHash": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
