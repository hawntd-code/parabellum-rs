              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "communities": {
      "$cid": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid) || (data.exists() && newData.exists() && newData.child('owner').val() === data.child('owner').val() && (root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'owner' || root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'admin')) || (data.exists() && !newData.exists() && data.child('owner').val() === auth.uid))",
        ".validate": "$cid.matches(/^c[0-9a-z]{12}$/) && newData.hasChildren(['name', 'owner', 'createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "image": {
          ".validate": "newData.isString() && newData.val().length <= 120000 && newData.val().beginsWith('data:image/')"
        },
        "owner": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "communityMembers": {
      "$cid": {
        ".read": "auth != null && data.child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && (($uid === auth.uid && !data.exists() && newData.child('role').val() === 'owner' && !newData.child('caps').exists() && newData.parent().parent().parent().child('communities').child($cid).child('owner').val() === auth.uid) || ($uid === auth.uid && !data.exists() && newData.child('role').val() === 'member' && !newData.child('caps').exists() && root.child('inviteCodes').child(newData.child('invite').val()).child('cid').val() === $cid && root.child('inviteCodes').child(newData.child('invite').val()).child('expiresAt').val() > now) || ($uid === auth.uid && !newData.exists() && data.child('role').val() !== 'owner') || ($uid !== auth.uid && root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'owner' && data.exists() && data.child('role').val() !== 'owner' && (!newData.exists() || newData.child('role').val() === 'member' || newData.child('role').val() === 'admin')) || ($uid !== auth.uid && root.child('communityMembers').child($cid).child(auth.uid).child('role').val() === 'admin' && data.child('role').val() === 'member' && (!newData.exists() || newData.child('role').val() === 'member')))",
