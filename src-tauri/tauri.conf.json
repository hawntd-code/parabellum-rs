{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parabellum",
  "identifier": "mx.parabellum.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Parabellum",
        "width": 1240,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0E0C13"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost http://icono.localhost https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Parabellum",
    "copyright": "Parabellum, launcher de Minecraft no premium",
    "icon": ["icons/icon.ico"]
  }
}
